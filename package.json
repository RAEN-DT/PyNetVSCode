{
  "name": "pynet-viewer",
  "displayName": "PyNET Viewer — BIM for VS Code",
  "description": "Explore federated BIM models in VS Code and let your AI assistant drive Autodesk Navisworks, Revit and Civil 3D in natural language.",
  "version": "0.1.29",
  "publisher": "RAENDT",
  "author": {
    "name": "RAEN Digital Tools"
  },
  "license": "MIT",
  "icon": "media/pynet.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "mcp",
    "bim",
    "ifc",
    "navisworks",
    "revit",
    "civil3d",
    "pynet",
    "autodesk",
    "3d viewer",
    "clash detection",
    "bim coordination",
    "aec"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RAEN-DT/PyNetVSCode"
  },
  "homepage": "https://github.com/RAEN-DT/PyNetVSCode#readme",
  "bugs": {
    "url": "https://github.com/RAEN-DT/PyNetVSCode/issues"
  },
  "galleryBanner": {
    "color": "#1e2430",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pynet.openViewer",
        "title": "Open BIM Model",
        "category": "PyNET",
        "icon": "$(add)"
      },
      {
        "command": "pynet.installBridge",
        "title": "Install / Repair MCP Bridge",
        "category": "PyNET"
      },
      {
        "command": "pynet.clearRecent",
        "title": "Clear Recent Models",
        "category": "PyNET",
        "icon": "$(clear-all)"
      },
      {
        "command": "pynet.removeRecent",
        "title": "Remove from Recent",
        "category": "PyNET",
        "icon": "$(trash)"
      },
      {
        "command": "pynet.openLibrary",
        "title": "Open Reference Library",
        "category": "PyNET",
        "icon": "$(book)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pynet",
          "title": "PyNET Viewer",
          "icon": "media/Pynet.svg"
        }
      ]
    },
    "views": {
      "pynet": [
        {
          "id": "pynet.home",
          "name": "Recent Models",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pynet.home",
        "contents": "Open a PyNET package (.pnt) to explore a BIM model in 3D.\n[Open BIM Model](command:pynet.openViewer)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pynet.openViewer",
          "when": "view == pynet.home",
          "group": "navigation"
        },
        {
          "command": "pynet.installBridge",
          "when": "view == pynet.home",
          "group": "1_actions@1"
        },
        {
          "command": "pynet.openLibrary",
          "when": "view == pynet.home",
          "group": "1_actions@2"
        },
        {
          "command": "pynet.clearRecent",
          "when": "view == pynet.home",
          "group": "1_actions@3"
        }
      ],
      "view/item/context": [
        {
          "command": "pynet.removeRecent",
          "when": "view == pynet.home && viewItem == pynetRecentModel",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "pynet.clearRecent",
          "when": "false"
        },
        {
          "command": "pynet.removeRecent",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "PyNET Viewer",
      "properties": {
        "pynet.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python 3.10+ executable. Leave empty to auto-detect (python / py -3 on PATH)."
        },
        "pynet.autoInstallBridgeOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "On first activation, install the PyNET MCP Bridge and configure detected AI clients if not already present."
        },
        "pynet.viewerPort": {
          "type": "number",
          "default": 0,
          "description": "Port for the local viewer server. 0 = pick a free port automatically."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build:viewer": "node ./scripts/build-viewer.mjs",
    "stage:library": "node ./scripts/stage-library.mjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run build:viewer && npm run stage:library && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
